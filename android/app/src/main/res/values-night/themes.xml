<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night-mode theme: the launcher background and splash background stay
      teal so the brand identity is consistent regardless of system theme.
      Status bar appearance differs (dark icons on dark background).
    -->
    <style name="Theme.TransferRate" parent="android:Theme.Material.NoActionBar">
        <!-- v0.32.0: windowLightStatusBar flipped to FALSE so icons
             render LIGHT (white) on the dark / OLED-black background.
             Previous TRUE would have left dark icons invisible on
             pure black during the brief splash → app transition.
             The runtime Theme.kt `isAppearanceLightStatusBars = !darkTheme`
             already does the same thing for the Compose lifetime;
             this XML setting matches it during cold-start splash. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <!-- v0.32.1: white "coin" behind the icon so the navy "TR" +
             dark refresh arrows stay readable on the v0.32.0 OLED-
             black splash background.  Without this, the navy logo
             elements blended into the pure-black bg and looked
             half-rendered for the ~200 ms the OS splash is on
             screen.  Matches the in-app TransferRateLogo wrap. -->
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
