<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark/OLED splash background.  v0.32.0: was inheriting the
        light splash_bg (#F1F4F8) which caused a bright white flash
        during cold-start on OLED devices in dark mode (splash shows
        for ~200 ms before Compose's pure-black background takes
        over).  Pure #000000 keeps the OLED pixels off for the entire
        cold-start → first-frame transition.
    -->
    <color name="splash_bg">#000000</color>
</resources>
