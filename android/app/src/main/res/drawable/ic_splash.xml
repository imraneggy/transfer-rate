<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen icon (Android 12+).

  The OS draws this drawable centered on the windowSplashScreenBackground
  color. Default container size is 192dp (no mask, no safe-zone clipping)
  so we can fill the full viewport without the launcher icon's safe-zone
  margins.

  Geometry: same T monogram as the launcher, scaled to use the full canvas:
    Crossbar: x =  8..56  y =  8..18   (width 48, thickness 10, r=3)
    Stem:     x = 27..37  y =  8..56   (width 10, length 48, bottom r=3)

  Drawn in white; the teal background lives in the theme attribute
  windowSplashScreenBackground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- Crossbar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,8 L53,8 A3,3 0 0 1 56,11 L56,15 A3,3 0 0 1 53,18 L11,18 A3,3 0 0 1 8,15 L8,11 A3,3 0 0 1 11,8 Z" />

    <!-- Stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,8 L37,8 L37,53 A3,3 0 0 1 34,56 L30,56 A3,3 0 0 1 27,53 Z" />
</vector>
