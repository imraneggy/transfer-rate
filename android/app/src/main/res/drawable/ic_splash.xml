<?xml version="1.0" encoding="utf-8"?>
<!--
  OS splash icon (Android 12+). Mirrors the launcher chart-line design,
  scaled for the splash container's 64dp viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- Faint baseline band -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10"
        android:pathData="M14,48 L50,48 A1.2,1.2 0 0 1 50,50.4 L14,50.4 A1.2,1.2 0 0 1 14,48 Z" />

    <!-- Ascending chart line in gold -->
    <path
        android:strokeColor="#FFD980"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M16,42 L28,33 L37,39 L50,18" />

    <!-- Two mid markers -->
    <path
        android:fillColor="#FFD980"
        android:fillAlpha="0.55"
        android:pathData="M28,33 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />
    <path
        android:fillColor="#FFD980"
        android:fillAlpha="0.55"
        android:pathData="M37,39 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />

    <!-- Final / "current" data point -->
    <path
        android:fillColor="#FFD980"
        android:pathData="M50,18 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.32"
        android:pathData="M50,18 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0 Z" />
</vector>
