<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background — brand deep navy #0E1F3A.

  Per Exchangia brand brief 2026-05-02. Adaptive icons receive a 108dp
  canvas; the outer 18dp gets masked by the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid deep navy fill -->
    <path
        android:fillColor="#0E1F3A"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Subtle radial highlight in mid-blue for depth -->
    <path
        android:fillColor="#1E3A5F"
        android:fillAlpha="0.55"
        android:pathData="M54,54 m-58,0 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0z" />
</vector>
