<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background.
  Solid deep teal that matches the app's primary brand color (#00665B).
  Adaptive icons receive 108dp canvas; the outer 18dp gets masked.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid teal fill -->
    <path
        android:fillColor="#00665B"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Subtle radial highlight to add depth without looking "wet" -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.06"
        android:pathData="M54,54 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0z" />
</vector>
