<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background — Exchangia brand soft gray (#F1F4F8).

  Switched from deep navy in v0.13.0 to match the primary "white-bg"
  icon variant from the brand sheet. The hero logo's dark navy strokes
  (rupee mark, E outline) need a light backdrop to read; on the navy
  backdrop they were nearly invisible.

  Adaptive icons receive a 108dp canvas; the outer 18dp gets masked by
  the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid soft-gray fill -->
    <path
        android:fillColor="#F1F4F8"
        android:pathData="M0,0h108v108h-108z" />
</vector>
