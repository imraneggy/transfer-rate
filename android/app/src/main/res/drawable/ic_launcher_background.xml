<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background — "infinity DXR" brand refresh.

  Flat Deep Navy (#071827) — the Adaptive Icon Background colour from
  the brand sheet (artifacts/Logo System.png, section 3). The
  foreground PNG carries the teal infinity loop + white AED/INR
  glyphs (ic_launcher_foreground.png); this flat navy is what shows
  through behind/around it under every launcher mask shape.

  Adaptive icons receive a 108dp canvas; the outer 18dp gets masked by
  the launcher (circle, squircle, etc.) so the flat fill just needs to
  cover the full canvas — no safe zone to respect for the background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#071827" />
</vector>
