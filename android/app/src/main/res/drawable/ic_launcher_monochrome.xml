<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon variant (Android 13+). Single white channel; the launcher
  tints to the wallpaper-derived theme color.

  "infinity DXR" brand refresh: white silhouette of the infinity
  money-flow loop + AED/INR glyphs (mipmap-xxxhdpi/ic_launcher_monochrome_image.png),
  derived by alpha-thresholding the same symbol used for
  ic_launcher_foreground.png. Replaces the old "TR" letterform vector —
  the full infinity-loop mark is the brand identity now, so the themed
  icon should match it rather than fall back to a monogram.

  Sized to the same 66dp safe zone as the foreground so any mask
  (circle/squircle/teardrop) won't crop content.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_monochrome_image"
    android:gravity="center" />
