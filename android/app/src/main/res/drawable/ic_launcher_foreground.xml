<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground — three horizontal bars descending in length,
  visualising a rate-comparison chart. White on teal background.

  Content stays inside the 66dp safe zone of the 108dp adaptive canvas
  (centered at x:[20,88], y:[24,82]) so masks (circle/squircle/teardrop)
  never crop the meaningful shapes.

  Bar geometry:
    Bar 1 (top, longest):     x = 22..86 (w=64)  y = 24..38  h=14  rounded r=7
    Bar 2 (middle):           x = 30..78 (w=48)  y = 46..60  h=14  rounded r=7
    Bar 3 (bottom, shortest): x = 38..70 (w=32)  y = 68..82  h=14  rounded r=7

  Each bar is a stadium shape (full semicircles at both ends).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bar 1: longest, top — represents the best rate -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M29,24 L79,24 A7,7 0 0 1 79,38 L29,38 A7,7 0 0 1 29,24 Z" />

    <!-- Bar 2: middle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,46 L71,46 A7,7 0 0 1 71,60 L37,60 A7,7 0 0 1 37,46 Z" />

    <!-- Bar 3: shortest, bottom -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,68 L63,68 A7,7 0 0 1 63,82 L45,82 A7,7 0 0 1 45,68 Z" />
</vector>
