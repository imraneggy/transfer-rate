<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground (v0.10) — single bold ascending chart line in
  gold, with three data-point markers, the final point larger to read as
  "the latest / best rate."

  Design intent:
    * Communicates "rates moving" / "comparison chart" instantly without
      relying on text. Reads at any size from 24dp (notification badge)
      to 192dp (high-density launcher).
    * Single shape with one colour story: less busy than the previous
      three-bar layout, more deliberate, more professional.
    * Geometry stays inside the 66dp safe zone of the 108dp adaptive
      canvas so any mask (circle/squircle/teardrop) won't crop content.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft baseline glow (a faint horizontal band underlining the chart,
         signals "axis" without being literal) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.10"
        android:pathData="M22,82 L88,82 A2,2 0 0 1 88,86 L22,86 A2,2 0 0 1 22,82 Z" />

    <!-- The ascending chart line: bold gold polyline with rounded joins -->
    <path
        android:strokeColor="#FFD980"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M26,72 L46,56 L62,66 L84,32" />

    <!-- Mid data-point markers (small, 60% opacity gold) -->
    <path
        android:fillColor="#FFD980"
        android:fillAlpha="0.55"
        android:pathData="M46,56 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z" />
    <path
        android:fillColor="#FFD980"
        android:fillAlpha="0.55"
        android:pathData="M62,66 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z" />

    <!-- Final / "current" data point: large solid gold circle with white
         inner highlight to read as polished, premium -->
    <path
        android:fillColor="#FFD980"
        android:pathData="M84,32 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.32"
        android:pathData="M84,32 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
</vector>
