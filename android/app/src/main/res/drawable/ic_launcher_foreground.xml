<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground (Exchangia brand 2026-05-02).

  Stylized "E" letterform in brand teal (#00B49E) with two currency cue
  accents:
    - Upper-right cyan ball: INR (₹) cue
    - Lower-right gold ball: AED (د.إ) cue

  The "E" is built as a single monoline composite of three rounded
  horizontal arms with a left spine — a clean, geometric reading that
  works from 24dp notification badges up to 192dp launchers.

  Geometry stays inside the 66dp safe zone of the 108dp adaptive canvas
  so any mask (circle/squircle/teardrop) won't crop content.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- =====  Letter E  =====
         Spine (vertical bar on the left, rounded top + bottom).
         Stroke is approximated as a filled rounded rect to allow gradient/
         multi-tone fills if we later add depth.  -->
    <path
        android:fillColor="#00B49E"
        android:pathData="M28,28 m0,5 a5,5 0 0,1 10,0 v42 a5,5 0 0,1 -10,0 z" />

    <!-- Top arm of E (long, rounded right end) -->
    <path
        android:fillColor="#00B49E"
        android:pathData="M28,28 m5,0 h35 a5,5 0 0,1 0,10 h-35 a5,5 0 0,1 0,-10 z" />

    <!-- Middle arm of E (shorter, rounded right end) -->
    <path
        android:fillColor="#00B49E"
        android:pathData="M28,49 m5,0 h25 a5,5 0 0,1 0,10 h-25 a5,5 0 0,1 0,-10 z" />

    <!-- Bottom arm of E (long, rounded right end, mirrors top) -->
    <path
        android:fillColor="#00B49E"
        android:pathData="M28,70 m5,0 h35 a5,5 0 0,1 0,10 h-35 a5,5 0 0,1 0,-10 z" />

    <!-- =====  Currency cues  =====
         INR (₹) cue: light cyan ball at upper-right, attached to the
         end of the top arm. Suggests "rupee marker" without literal
         glyph (which would be illegible at small sizes).  -->
    <path
        android:fillColor="#9DEAD0"
        android:pathData="M76,33 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M76,33 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z" />

    <!-- AED cue: brand gold ball at lower-right -->
    <path
        android:fillColor="#F4B940"
        android:pathData="M76,75 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M76,75 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z" />
</vector>
