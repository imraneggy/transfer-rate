<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground — three ascending vertical bars in white.

  Reads as a bar chart / ranking visualisation: "shortest = lowest rate,
  tallest = best rate." The universal visual shorthand for "comparison" /
  "ranking" — instantly communicates the app's purpose.

  Geometry on the 108dp adaptive canvas (66dp safe zone, [21..87] each axis):

    Bar 1 (left, shortest):   x = 22..38   y = 58..86   h = 28
    Bar 2 (middle):           x = 46..62   y = 42..86   h = 44
    Bar 3 (right, tallest):   x = 70..86   y = 26..86   h = 60

    Width: 16 each.  Top corners: rounded r=8 (full semicircle).
    Bottom corners: square (sit on the same baseline).

  Each bar is drawn as a single path: rectangle with rounded top.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bar 1: left, shortest -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,66
                          A8,8 0 0 1 30,58
                          L30,58
                          A8,8 0 0 1 38,66
                          L38,86
                          L22,86
                          Z" />

    <!-- Bar 2: middle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,50
                          A8,8 0 0 1 54,42
                          L54,42
                          A8,8 0 0 1 62,50
                          L62,86
                          L46,86
                          Z" />

    <!-- Bar 3: right, tallest -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M70,34
                          A8,8 0 0 1 78,26
                          L78,26
                          A8,8 0 0 1 86,34
                          L86,86
                          L70,86
                          Z" />
</vector>
