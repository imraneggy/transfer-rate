<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground — bold T monogram in white.
  Adaptive canvas is 108x108 dp; content stays inside the 66dp safe zone
  ([21..87] x [21..87]) so any mask (circle/squircle/teardrop) won't crop.

  Geometry (centered):
    Crossbar: x = 22..86  y = 22..38   (width 64, thickness 16, r=4)
    Stem:     x = 46..62  y = 22..86   (width 16, length 64, bottom r=4)

  Both shapes are pure white; the teal background lives in
  ic_launcher_background.xml. Two paths for clarity (could be merged
  into one via constructive geometry, but two paths render identically
  and the source is more legible).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crossbar (top horizontal) — rounded outer corners only -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M26,22
                          L82,22
                          A4,4 0 0 1 86,26
                          L86,34
                          A4,4 0 0 1 82,38
                          L26,38
                          A4,4 0 0 1 22,34
                          L22,26
                          A4,4 0 0 1 26,22
                          Z" />

    <!-- Stem (vertical) — rounded only at the bottom; top merges into crossbar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,22
                          L62,22
                          L62,82
                          A4,4 0 0 1 58,86
                          L50,86
                          A4,4 0 0 1 46,82
                          Z" />
</vector>
