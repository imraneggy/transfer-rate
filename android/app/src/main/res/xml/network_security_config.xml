<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config.

  Defaults are deny-cleartext globally. We further constrain so the app can
  only talk to the GitHub Pages domain hosting our rates.json — even if a
  bug or supply-chain attack tries to exfiltrate to elsewhere, the platform
  refuses the connection.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Hard allowlist: only these domains. -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Static rates / history JSON served by GitHub Pages. -->
        <domain includeSubdomains="false">imraneggy.github.io</domain>
        <!-- Cloudflare Worker that proxies workflow_dispatch to GitHub
             Actions when the user taps Refresh.  The Worker holds the
             GitHub PAT in its encrypted env so the app can trigger a
             fresh scrape without ever touching the token. -->
        <domain includeSubdomains="false">transfer-rate-refresh.imranbatchait.workers.dev</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
