<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ explicit backup/transfer rules. Same posture: nothing
     leaves the device, since the app stores nothing user-specific. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
