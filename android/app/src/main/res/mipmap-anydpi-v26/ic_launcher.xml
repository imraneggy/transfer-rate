<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon manifest (Android 8.0 / API 26+).

  "infinity DXR" brand refresh (artifacts/Logo System.png):
  Background: flat Deep Navy #071827 (drawable/ic_launcher_background.xml).
  Foreground: high-res density-bucketed PNG of the infinity money-flow
  loop + AED/INR glyphs (mipmap-{m,h,xh,xxh,xxxh}dpi/ic_launcher_foreground.png)
  — too detailed to render faithfully in vector path data.
  Monochrome: white silhouette of the same symbol for Android 13+
  themed icons (drawable/ic_launcher_monochrome.xml).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
