    <string name="about_language_unavailable">Language picker not available on this device — change your phone\'s language in Settings → System → Languages.</string>

    <!-- Welcome modal -->
    <string name="welcome_title">Welcome to Transfer Rate</string>
    <string name="welcome_subtitle">A free, open-source comparison app for sending money from the UAE to India. No accounts, no ads, no analytics.</string>
    <string name="welcome_got_it">Got it</string>
    <string name="welcome_revisit_hint">You can re-read this from the About screen any time.</string>
    <string name="welcome_bullet_rates_title">Live remittance rates</string>
    <string name="welcome_bullet_rates_body">Up to twelve UAE→India providers compared side-by-side: Wise, Aspora, Remitly, TransferGo, Al Ansari, Al Dahab, Ahalia, Federal, GCC, Index, Lari, LuLu. The provider giving you the most rupees gets a BEST badge.</string>
    <string name="welcome_bullet_midmarket_title">Mid-market benchmark</string>
    <string name="welcome_bullet_midmarket_body">The big number at the top is the wholesale interbank rate — every provider charges some markup over it. Each card shows the markup explicitly so the comparison is honest.</string>
    <string name="welcome_bullet_metals_title">Gold &amp; silver</string>
    <string name="welcome_bullet_metals_body">Tap the gold/silver card on home for live UAE and India rates — 24K + 22K gold, silver per gram and per kilogram, plus 30-day history.</string>
    <string name="welcome_bullet_refresh_title">Refresh button</string>
    <string name="welcome_bullet_refresh_body">The refresh button in the top bar pulls fresh rates on demand. The app already shows the last cron-published rates within a second; truly-fresh upstream rates land silently 30–45 seconds later.</string>
    <string name="welcome_bullet_alerts_title">Daily-high alerts (default ON)</string>
    <string name="welcome_bullet_alerts_body">A status-bar notification fires when a provider beats today\'s previous best AED→INR rate. Toggle off any time in About → Notifications. Permission is asked once on first launch.</string>
    <string name="welcome_bullet_privacy_title">Private by design</string>
    <string name="welcome_bullet_privacy_body">Outbound network access is locked down at the application layer; no telemetry, no analytics, no third-party SDKs, no account.</string>
</resources>
