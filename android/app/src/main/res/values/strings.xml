    <!--
        Relative-time phrases (v0.32.0 — full i18n).
        Wired through Android's CLDR-aware <plurals> resource so each
        locale picks the correct quantity form (one/other in Tamil,
        Hindi, Malayalam; same in English).  Callers pass `quantity`
        + `formatArg` — Android does the rest, no Kotlin-side
        if-else needed.
    -->
    <string name="time_just_now">just now</string>
    <plurals name="time_minutes_ago">
        <item quantity="one">1 minute ago</item>
        <item quantity="other">%d minutes ago</item>
    </plurals>
    <plurals name="time_hours_ago">
        <item quantity="one">1 hour ago</item>
        <item quantity="other">%d hours ago</item>
    </plurals>
    <plurals name="time_days_ago">
        <item quantity="one">1 day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>

