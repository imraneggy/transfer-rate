# Local-only secrets for debug builds.  Copy this file to
# `android/secrets.properties` and fill in the values.  The real file is
# gitignored; never commit it.
#
# Resolution order in build.gradle.kts (defaultConfig):
#   1. Environment variable REFRESH_TRIGGER_SECRET   (used by CI; lives
#      in GitHub Actions repo secrets, injected at build time)
#   2. This file (used for local debug builds)
#   3. Empty string (refresh-trigger feature disables gracefully)
#
# Get the current value from the SHARED_SECRET variable in the
# Cloudflare Worker dashboard:
#   https://dash.cloudflare.com → Workers & Pages → transfer-rate-refresh
#   → Settings → Variables and Secrets

REFRESH_TRIGGER_SECRET=replace-me-with-the-cloudflare-shared-secret
