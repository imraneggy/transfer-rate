# Copy this file to keystore.properties (in the same directory) and fill in
# the actual values. The real file is gitignored — never commit it.
#
# To generate a release keystore (one-time):
#
#   keytool -genkey -v \
#     -keystore release.jks \
#     -alias transferrate \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000 \
#     -dname "CN=Transfer Rate, OU=Open Source, O=imraneggy, L=Dubai, C=AE"
#
# Move release.jks alongside this file, then fill in below.

storeFile=release.jks
storePassword=PUT_YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=transferrate
keyPassword=PUT_YOUR_KEY_PASSWORD_HERE
