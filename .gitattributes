# Normalise line endings across platforms.
# Stored as LF in the repo; checked out with native EOL where appropriate.
* text=auto eol=lf

# Source files: always LF
*.py    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# Windows-only files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binaries — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.apk   binary
*.aab   binary
*.jks   binary
*.keystore binary
*.zip   binary
